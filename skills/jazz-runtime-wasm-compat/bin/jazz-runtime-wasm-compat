#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

cat <<EOF
jazz-runtime-wasm-compat documents Jazz runtime and WASM compatibility.

Read:
- ${SKILL_DIR}/SKILL.md
- ${SKILL_DIR}/README.md
- ${SKILL_DIR}/references/runtime-wasm-compat/
EOF
