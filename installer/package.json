{
  "name": "@alcyone-labs/agent-skills",
  "version": "2.0.0",
  "description": "Manifest-driven Agent Skills lifecycle CLI (.agents canonical install model)",
  "type": "module",
  "main": "./dist/installer.js",
  "bin": {
    "agent-skills": "./dist/installer.js"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "bun run ./src/installer.ts",
    "start": "node ./dist/installer.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/core/lifecycle.test.js",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "skills",
    "cli",
    "installer",
    "opencode",
    "gemini",
    "claude",
    "mcp"
  ],
  "author": "Alcyone Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alcyone-Labs/agent-skills.git",
    "directory": "installer"
  },
  "homepage": "https://github.com/Alcyone-Labs/agent-skills/tree/main/installer",
  "bugs": {
    "url": "https://github.com/Alcyone-Labs/agent-skills/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@alcyone-labs/arg-parser": "^2.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.8",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
